datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client-js"
  output   = "../lib/generated/client"
}

// ----------------------------------------------------
// 1. MULTI-BRANCH SYSTEM (منظومة الفروع المتعددة)
// ----------------------------------------------------
model Branch {
  id              String   @id @default(cuid())
  name            String // e.g. "فرع عباس العقاد الرئيسي", "فرع أول عباس - كشري التحرير"
  code            String   @unique // "BR-ABBAS-MAIN", "BR-TAHRIR"
  address         String
  phone           String
  whatsapp        String?
  googleMapsUrl   String?
  isActive        Boolean  @default(true)
  isDayOffEnabled Boolean  @default(false)
  weeklyDayOff    String   @default("NONE") // NONE, MONDAY, etc.
  dayOffMessage   String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  users        User[]
  branchStocks BranchStock[]
  invoices     Invoice[]
  expenses     Expense[]
  shifts       Shift[]
  offers       Offer[]
  customers    Customer[]
  purchases    PurchaseInvoice[]
  returns      ReturnInvoice[]
}

// ----------------------------------------------------
// 2. USERS & RBAC (طاقم العمل والمستخدمين والصلاحيات)
// ----------------------------------------------------
model User {
  id        String   @id @default(cuid())
  username  String   @unique
  password  String
  pin       String   @default("157230") // PIN سريع للكاشير
  name      String
  role      String // "owner" | "general_manager" | "branch_manager" | "cashier" | "storekeeper"
  branchId  String?
  branch    Branch?  @relation(fields: [branchId], references: [id], onDelete: SetNull)
  phone     String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  invoicesHandled Invoice[]
  shiftsOpened    Shift[]   @relation("ShiftsOpened")
  shiftsClosed    Shift[]   @relation("ShiftsClosed")
}

// ----------------------------------------------------
// 3. CLOTHING INVENTORY: CATEGORIES, PRODUCTS, VARIANTS
// ----------------------------------------------------
model Category {
  id        String   @id @default(cuid())
  nameAr    String   @unique // "تيشرتات أوفر سايز", "بناطيل جينز", إلخ
  nameEn    String?
  slug      String   @unique
  icon      String? // Emoji or Lucide icon name
  image     String?
  sortOrder Int      @default(0)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  products Product[]
}

model Product {
  id            String    @id @default(cuid())
  nameAr        String
  nameEn        String?
  sku           String?   @unique // e.g. "BAZ-TSH-001"
  description   String?
  categoryId    String?
  category      Category? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  basePrice     Float // سعر البيع الافتراضي
  costPrice     Float     @default(0.0) // سعر التكلفة
  discountPrice Float? // سعر الخصم إن وجد
  featuredImage String?
  images        String    @default("[]") // JSON array of image URLs
  material      String? // قطن 100%، ميلتون معالج، جينز تركي، إلخ
  brand         String    @default("BAZAAR")
  isFeatured    Boolean   @default(false)
  isActive      Boolean   @default(true)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  variants ProductVariant[]
}

model ProductVariant {
  id                String   @id @default(cuid())
  productId         String
  product           Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  color             String // e.g. "أسود", "أبيض", "كحلي", "بيج", "زيتي"
  colorHex          String? // "#000000", "#FFFFFF", etc.
  image             String? // صورة القطعة بهذا اللون والموديل
  size              String // "S", "M", "L", "XL", "2XL", "3XL", "4XL"
  barcode           String   @unique // Unique Barcode string e.g. "6221001001"
  sku               String? // e.g. "BAZ-TSH-001-BLK-XL"
  priceOverride     Float? // If this variant has a different price
  costPriceOverride Float?
  stockCentral      Int      @default(0) // الرصيد بالمخزن المركزي الرئيسي المشترك
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  branchStocks  BranchStock[]
  invoiceLines  InvoiceLine[]
  transferLines StockTransferLine[]
  returnLines   ReturnInvoiceLine[]
  purchaseLines PurchaseInvoiceLine[]

  @@unique([productId, color, size])
}

// ----------------------------------------------------
// 4. BRANCH ALLOCATION & STOCK TRANSFERS
// ----------------------------------------------------
model BranchStock {
  id               String         @id @default(cuid())
  variantId        String
  variant          ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)
  branchId         String
  branch           Branch         @relation(fields: [branchId], references: [id], onDelete: Cascade)
  quantity         Int            @default(0) // الرصيد المعروض بصالة بيع الفرع
  alertLowQuantity Int            @default(2) // تنبيه عند وصول الرصيد لقطعتين
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  @@unique([variantId, branchId])
}

model StockTransfer {
  id             String   @id @default(cuid())
  transferNumber String   @unique // "TRF-2026-001"
  fromLocation   String // "CENTRAL_WAREHOUSE" or Branch ID
  toLocation     String // Branch ID
  status         String   @default("PENDING") // "PENDING" | "COMPLETED" | "CANCELLED"
  requestedBy    String?
  approvedBy     String?
  notes          String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  lines StockTransferLine[]
}

model StockTransferLine {
  id         String         @id @default(cuid())
  transferId String
  transfer   StockTransfer  @relation(fields: [transferId], references: [id], onDelete: Cascade)
  variantId  String
  variant    ProductVariant @relation(fields: [variantId], references: [id], onDelete: Restrict)
  quantity   Int
  notes      String?
}

// ----------------------------------------------------
// 5. CUSTOMERS & LOYALTY CRM (العملاء ونقاط الولاء)
// ----------------------------------------------------
model Customer {
  id                 String    @id @default(cuid())
  name               String
  phone              String    @unique
  email              String?
  address            String?
  governorate        String?   @default("القاهرة")
  loyaltyPoints      Int       @default(0)
  totalSpent         Float     @default(0.0)
  totalVisits        Int       @default(0)
  vipLevel           String    @default("REGULAR") // "REGULAR" | "SILVER" | "GOLD" | "ROYAL_VIP"
  branchId           String?
  branch             Branch?   @relation(fields: [branchId], references: [id], onDelete: SetNull)
  openingBalance     Float     @default(0.0)
  openingBalanceDate DateTime?
  totalDebt          Float     @default(0.0)
  creditLimit        Float     @default(0.0)
  notes              String?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  invoices     Invoice[]
  transactions CustomerTransaction[]
  returns      ReturnInvoice[]
}

// ----------------------------------------------------
// 6. INVOICES & POS SALES (فواتير المبيعات ونقطة البيع)
// ----------------------------------------------------
model Invoice {
  id              String    @id @default(cuid())
  invoiceNumber   String    @unique // "BAZ-1001"
  branchId        String
  branch          Branch    @relation(fields: [branchId], references: [id], onDelete: Restrict)
  cashierId       String?
  cashierUser     User?     @relation(fields: [cashierId], references: [id], onDelete: SetNull)
  customerId      String?
  customer        Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)
  customerName    String?
  customerPhone   String?
  orderType       String    @default("IN_STORE_POS") // "IN_STORE_POS" | "ONLINE_ORDER" | "WHATSAPP_ORDER"
  subTotal        Float
  discountAmount  Float     @default(0.0)
  taxAmount       Float     @default(0.0)
  finalTotal      Float
  paidAmount      Float
  remainingAmount Float     @default(0.0)
  paymentMethod   String    @default("CASH") // "CASH" | "VISA" | "INSTAPAY" | "VODAFONE_CASH" | "SPLIT"
  splitDetails    String? // JSON if split
  status          String    @default("PAID") // "PAID" | "PENDING_DELIVERY" | "RETURNED" | "EXCHANGED" | "CANCELLED"
  notes           String?
  shiftId         String?
  shift           Shift?    @relation(fields: [shiftId], references: [id], onDelete: SetNull)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  lines   InvoiceLine[]
  returns ReturnInvoice[]
}

model InvoiceLine {
  id             String         @id @default(cuid())
  invoiceId      String
  invoice        Invoice        @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  variantId      String
  variant        ProductVariant @relation(fields: [variantId], references: [id], onDelete: Restrict)
  productName    String
  color          String
  size           String
  barcode        String
  quantity       Int
  unitPrice      Float
  costPrice      Float          @default(0.0)
  discountAmount Float          @default(0.0)
  total          Float
}

// ----------------------------------------------------
// 7. DAILY SHIFTS (الورديات وإقفال الكاشير)
// ----------------------------------------------------
model Shift {
  id             String    @id @default(cuid())
  shiftNumber    String    @unique // "SH-ABBAS-20261113-001"
  branchId       String
  branch         Branch    @relation(fields: [branchId], references: [id], onDelete: Cascade)
  openedById     String
  openedByUser   User      @relation("ShiftsOpened", fields: [openedById], references: [id])
  closedById     String?
  closedByUser   User?     @relation("ShiftsClosed", fields: [closedById], references: [id])
  startTime      DateTime  @default(now())
  endTime        DateTime?
  status         String    @default("OPEN") // "OPEN" | "CLOSED"
  openingCash    Float     @default(0.0)
  expectedCash   Float     @default(0.0)
  actualCash     Float     @default(0.0)
  cashDifference Float     @default(0.0)
  totalSales     Float     @default(0.0)
  cashSales      Float     @default(0.0)
  visaSales      Float     @default(0.0)
  instapaySales  Float     @default(0.0)
  vodafoneSales  Float     @default(0.0)
  totalReturns   Float     @default(0.0)
  expensesAmount Float     @default(0.0)
  handedTo       String?
  notes          String?
  createdAt      DateTime  @default(now())

  invoices Invoice[]
  expenses Expense[]
}

// ----------------------------------------------------
// 8. EXPENSES (المصروفات النثرية والتشغيلية)
// ----------------------------------------------------
model Expense {
  id            String   @id @default(cuid())
  branchId      String
  branch        Branch   @relation(fields: [branchId], references: [id], onDelete: Cascade)
  title         String // e.g. "ضيافة عملاء", "أكياس مطبوعة", "فواتير كهرباء"
  amount        Float
  category      String   @default("MISC") // "RENT" | "UTILITIES" | "SUPPLIES" | "SALARIES" | "HOSPITALITY" | "MARKETING" | "MISC"
  paymentMethod String   @default("CASH")
  recordedBy    String?
  notes         String?
  shiftId       String?
  shift         Shift?   @relation(fields: [shiftId], references: [id], onDelete: SetNull)
  createdAt     DateTime @default(now())
}

// ----------------------------------------------------
// 9. LIVE CHAT & COMMUNICATIONS (المحادثات المباشرة)
// ----------------------------------------------------
model ChatMessage {
  id             String   @id @default(cuid())
  conversationId String // customer phone or id
  branchId       String?
  customerPhone  String
  customerName   String
  sender         String // "CUSTOMER" | "STORE" | "ADMIN"
  senderName     String
  message        String
  isRead         Boolean  @default(false)
  createdAt      DateTime @default(now())
}

// ----------------------------------------------------
// 10. WEB PUSH NOTIFICATIONS (إشعارات الهواتف)
// ----------------------------------------------------
model PushSubscription {
  id            String   @id @default(cuid())
  endpoint      String   @unique
  p256dh        String
  auth          String
  userRole      String   @default("CUSTOMER") // "CUSTOMER" | "ADMIN" | "CASHIER"
  branchId      String?
  customerPhone String?
  userName      String?
  createdAt     DateTime @default(now())
}

// ----------------------------------------------------
// 11. OFFERS & PROMOTIONS (العروض الحصرية لكل فرع)
// ----------------------------------------------------
model Offer {
  id               String    @id @default(cuid())
  titleAr          String
  badge            String? // e.g. "خصم 30% 🔥"
  price            Float
  oldPrice         Float?
  discountPercent  Int?
  image            String?
  description      String?
  features         String    @default("[]") // JSON array of features
  branchId         String?
  branch           Branch?   @relation(fields: [branchId], references: [id], onDelete: SetNull)
  announcementText String? // نص الإشعار الترويجي الذي يصل لهواتف العملاء
  broadcastSentAt  DateTime?
  isActive         Boolean   @default(true)
  sortOrder        Int       @default(0)
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
}

// ----------------------------------------------------
// 12. SYSTEM SETTINGS & MASTER EMERGENCY LOCK
// ----------------------------------------------------
model SystemSettings {
  id                Int    @id @default(1)
  brandNameAr       String @default("بزار كاجوال وير")
  brandNameEn       String @default("BAZAAR Casual Wear")
  logoUrl           String @default("/logo.jpg")
  hotline           String @default("01008038041")
  whatsappNumber    String @default("01008038041")
  facebookUrl       String @default("https://www.facebook.com/share/1Dq8mYkoij/")
  facebookUrl2      String @default("https://www.facebook.com/profile.php?id=100090095202108&mibextid=wwXIfr")
  tiktokUrl         String @default("https://www.tiktok.com/@mohamed_ashraf327?_r=1&_t=ZS-9BMGDqeFbr2")
  instagramUrl      String @default("https://www.instagram.com/bazaar_casual_wear")
  receiptFooterText String @default("شكراً لزيارتكم بزار كاجوال وير • الاستبدال والاسترجاع خلال 14 يوماً بأصل الفاتورة والباركود")

  // Hero Section Dynamic Customization (صورة الهيدر والبانر الشبابي الديناميكي)
  heroBannerImage String @default("https://images.unsplash.com/photo-1516257984-b1b4d707412e?auto=format&fit=crop&w=1000&q=80")
  heroTagline     String @default("طقم الأوفر سايز والكارجو التكتيكال")
  heroDescription String @default("قطن مصري 100% هيفي ويت معالج ضد الانكماش مع نسيج كارجو ووتر بروف")

  // Emergency Master Lockout (زر الطوارئ الحصري للمالك Maestro لتعطيل الحسابات وضمان الملكية)
  isMasterLocked    Boolean @default(false)
  masterLockMessage String  @default("النظام في وضع الصيانة والتحديث الإداري العام. يرجى التواصل مع إدارة بزار كاجوال وير.")

  // AI Gemini & Integration Keys
  geminiApiKey           String?
  loyaltyPointsPer100Egp Int     @default(5)
  currency               String  @default("ج.م")

  // Choco House Style Landing Page Offers Section
  offersSectionEnabled Boolean @default(true)
  offersBadge          String  @default("عروض حصرية محدودة 🔥")
  offersTitle          String  @default("العروض الخاصة والكومبوهات الملكية")
  offersSubtitle       String  @default("عروض استثنائية وباقات متجددة أسبوعياً — اسأل الكاشير عن عرض اليوم")
  offersCards          String  @default("[]") // JSON of {id, title, desc, icon, badge}
  offersBannerBadge    String  @default("الأكثر طلباً هذا الأسبوع")
  offersBannerTitle    String  @default("طقم الأوفر سايز والكارجو التكتيكال")
  offersBannerImage    String  @default("https://images.unsplash.com/photo-1552374196-1ab2a1c593e8?auto=format&fit=crop&w=1200&q=80")
  offersBannerLinkText String  @default("تصفح العرض في التشكيلة")
  offersBannerLinkHref String  @default("#collection")

  // Smart NFC & QR Card Profile Hub
  smartCardTitle         String @default("بزار كاجوال وير • BAZAAR")
  smartCardBio           String @default("براند الشارع المصري الفاخر • خامات قطنية تركي وأوفر سايز عصري")
  smartCardInstapay      String @default("bazaar@instapay")
  smartCardVodafoneCash  String @default("01008038041")
  smartCardGoogleReviews String @default("https://maps.app.goo.gl/MzCnj5n3mP29uurK6")
  smartCardCustomLinks   String @default("[]") // JSON array of custom links: { id, title, icon, url, category, isActive }

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ----------------------------------------------------
// 13. CUSTOMER FINANCIAL TRANSACTIONS & DEBT LEDGER
// ----------------------------------------------------
model CustomerTransaction {
  id              String   @id @default(cuid())
  customerId      String
  customer        Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  type            String // "INVOICE" | "PAYMENT" | "RETURN" | "OPENING_BALANCE"
  amount          Float
  referenceNumber String?
  paymentMethod   String? // "CASH" | "VISA" | "INSTAPAY"
  notes           String?
  createdAt       DateTime @default(now())
}

// ----------------------------------------------------
// 14. SUPPLIERS & PURCHASES SYSTEM (الموردين والمشتريات)
// ----------------------------------------------------
model Supplier {
  id                 String    @id @default(cuid())
  name               String    @unique
  contactName        String?
  phone              String?
  address            String?
  openingBalance     Float     @default(0.0)
  openingBalanceDate DateTime?
  totalDebt          Float     @default(0.0) // مديونية المورد (المستحقات له)
  notes              String?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  transactions     SupplierTransaction[]
  purchaseInvoices PurchaseInvoice[]
}

model SupplierTransaction {
  id              String   @id @default(cuid())
  supplierId      String
  supplier        Supplier @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  type            String // "PURCHASE" | "PAYMENT" | "RETURN" | "OPENING_BALANCE"
  amount          Float
  referenceNumber String?
  paymentMethod   String? // "CASH" | "BANK_TRANSFER"
  notes           String?
  createdAt       DateTime @default(now())
}

model PurchaseInvoice {
  id            String   @id @default(cuid())
  invoiceNumber String   @unique // "PUR-2026-001"
  supplierId    String
  supplier      Supplier @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  branchId      String?
  branch        Branch?  @relation(fields: [branchId], references: [id], onDelete: SetNull)
  type          String   @default("PURCHASE") // "PURCHASE" | "RETURN"
  totalAmount   Float
  paidAmount    Float    @default(0.0)
  remainingDebt Float    @default(0.0)
  status        String   @default("COMPLETED") // "COMPLETED" | "CANCELLED"
  notes         String?
  createdAt     DateTime @default(now())

  lines PurchaseInvoiceLine[]
}

model PurchaseInvoiceLine {
  id                String          @id @default(cuid())
  purchaseInvoiceId String
  purchaseInvoice   PurchaseInvoice @relation(fields: [purchaseInvoiceId], references: [id], onDelete: Cascade)
  variantId         String
  variant           ProductVariant  @relation(fields: [variantId], references: [id], onDelete: Restrict)
  quantity          Int
  costPrice         Float
  total             Float
}

// ----------------------------------------------------
// 15. SALES RETURNS & EXCHANGES (مردودات المبيعات والاستبدال)
// ----------------------------------------------------
model ReturnInvoice {
  id                String    @id @default(cuid())
  returnNumber      String    @unique // "RET-2026-001"
  originalInvoiceId String?
  originalInvoice   Invoice?  @relation(fields: [originalInvoiceId], references: [id], onDelete: SetNull)
  customerId        String?
  customer          Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)
  branchId          String
  branch            Branch    @relation(fields: [branchId], references: [id], onDelete: Restrict)
  type              String    @default("RETURN") // "RETURN" | "EXCHANGE"
  settlementType    String    @default("CASH_REFUND") // "CASH_REFUND" | "DEBT_CREDIT" | "EXCHANGE"
  refundAmount      Float     @default(0.0)
  reason            String?
  notes             String?
  createdAt         DateTime  @default(now())

  lines ReturnInvoiceLine[]
}

model ReturnInvoiceLine {
  id              String         @id @default(cuid())
  returnInvoiceId String
  returnInvoice   ReturnInvoice  @relation(fields: [returnInvoiceId], references: [id], onDelete: Cascade)
  variantId       String
  variant         ProductVariant @relation(fields: [variantId], references: [id], onDelete: Restrict)
  quantity        Int
  unitPrice       Float
  total           Float
}

// ----------------------------------------------------
// 16. SEASONS & PROMOTIONS (المواسم والعروض السنوية)
// ----------------------------------------------------
model Season {
  id        String    @id @default(cuid())
  name      String    @unique // "موسم صيف 2026", "موسم شتاء 2026"
  slug      String    @unique
  startDate DateTime?
  endDate   DateTime?
  isActive  Boolean   @default(true)
  notes     String?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}
